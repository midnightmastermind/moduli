           ]
          },
          "itemIdVar": "$dqId",
          "itemVar": "$dq"
         }
        },
        {
         "id": "34yo9k14gv",
         "type": "if",
         "condition": {
          "operator": "AND",
          "rules": [
           {
            "id": "rv22i4gnd4",
            "left": "$dqId",
            "comparator": "IS_NOT_EMPTY",
            "right": ""
           },
           {
            "id": "apm8230g",
            "left": "$dq.id",
            "comparator": "IS_NOT_EMPTY",
            "right": ""
           },
           {
            "id": "clc6rk9y5",
            "left": "$dq.fields.Kq-dG1dQ2-89.value",
