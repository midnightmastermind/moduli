          },
          {
           "id": "_i295n4hX11N",
           "type": "if",
           "condition": {
            "operator": "AND",
            "rules": [
             {
              "id": "TvwwRVjPbfvU",
              "left": "$kid2.role",
              "comparator": "IS_NOT",
