        },
        {
         "id": "331cchv2kl8",
         "type": "action",
         "config": {
          "type": "FIND",
          "over": "$allOccurrences",
          "predicate": {
           "operator": "AND",
           "rules": [
            {
             "id": "z11ux8xw1qf",
             "left": "_ancestors",
             "comparator": "HAS_ANCESTOR",
             "right": "$colId"
            },
            {
             "id": "c8jvpq2yyg",
             "left": "identitySignature",
             "comparator": "IS",
             "right": "daypage:Daily Question/question"
