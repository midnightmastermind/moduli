# Jonah assistant — local LLM (Ollama). llama3.2:3b is tuned for tool-calling
# and benched ~59s vs ~94s for qwen2.5-coder:7b on this box, and it uses the
# native tool_calls channel. Falls back to qwen2.5-coder:7b in code if unset.
OLLAMA_MODEL=llama3.2:3b
# Optional tuning (defaults shown): context window, output cap, model keep-warm,
# per-generation timeout, curated offline toolset.
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=768
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT_MS=180000        # per-generation cap (must exceed ~60-100s real gen time)
# OLLAMA_TOTAL_BUDGET_MS=300000   # whole-request budget across tool iterations
# OLLAMA_TOOL_ALLOWLIST=

# Stable token for the Jonah assistant drawer — paste once into the drawer; survives reseeds.
ASSISTANT_API_TOKEN=moduli_Nv7elyBJ7jyp_0_TtvAI-pV-jNKI30U24EKuRwgOtcojy
