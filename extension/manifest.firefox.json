{
  "manifest_version": 3,
  "name": "Moduli Companion",
  "version": "0.1.0",
  "description": "Lets Moduli open web pages inside a panel, and clip anything into your grid from the right-click menu.",
  "browser_specific_settings": {
    "gecko": {
      "id": "moduli-companion@viafluere.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "framing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  }
}